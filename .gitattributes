# Normalise text to LF in the repository so Python and Node sources stay
# byte-identical across Windows, Linux and CI runners.
* text=auto

*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.tsv text eol=lf

# Astro and document payloads must never be line-ending converted.
*.pdf binary
*.xisf binary
*.fits binary
*.fit binary
*.swp binary
*.bsp binary
*.png binary
*.jpg binary
*.jpeg binary
