<ResourceDictionary x:Class="Zakfo.Unphased.Features.planner.Resources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:planner="clr-namespace:Zakfo.Unphased.Features.planner">

    <!-- Data template for the plugin's dockable panel. N.I.N.A.'s pane
         template selector looks up "<VM type full name>_Dockable" in the
         merged application resources, which is what the code-behind below
         registers. Colours here are DynamicResource on N.I.N.A.'s own brush
         keys, so the panel follows the user's palette; when the night button is
         on, PlannerViewGlue.NightPalette installs the values of N.I.N.A.'s red
         "Dark" scheme in this panel's own resource dictionary and the lookup
         stops there, leaving every other tab alone. That reach is exactly as
         far as the plugin's own markup: N.I.N.A.'s control styles bound their
         palette when the application started, so a plugin cannot recolour them
         without changing the palette for everyone. The chart repaints itself
         through NightChartControl using PlannerPalette either way. -->
    <DataTemplate x:Key="PlannerDockableTemplate">
        <Grid Margin="4" planner:PlannerViewGlue.NightPalette="{Binding Planner.DarkMode}"
            planner:PlannerViewGlue.KeyboardScope="True"
            Background="{DynamicResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Date navigation. The buttons name their own Foreground rather than leaving
                 it to N.I.N.A.'s button style: in the normal scheme that resolves to the
                 very brush the style would have used, so nothing changes, and at night it
                 picks up the shadowed night-vision value. The button bodies are deliberately
                 left alone - recolouring those means overriding N.I.N.A.'s own style, which
                 would either flatten the hover feedback or leak into the app palette. -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,2,2,4">
                <Button Content="&lt;" Padding="8,2" Margin="0,0,4,0"
                    Foreground="{DynamicResource ButtonForegroundBrush}"
                    Command="{Binding PrevNightCommand}"/>
                <Button Content="Tonight" Padding="8,2" Margin="0,0,4,0"
                    Foreground="{DynamicResource ButtonForegroundBrush}"
                    Command="{Binding TonightCommand}"/>
                <Button Content="&gt;" Padding="8,2" Margin="0,0,8,0"
                    Foreground="{DynamicResource ButtonForegroundBrush}"
                    Command="{Binding NextNightCommand}"/>
                <Button Content="Refresh" Padding="8,2" Margin="0,0,8,0"
                    Foreground="{DynamicResource ButtonForegroundBrush}"
                    Command="{Binding RefreshCommand}"/>
                <!-- The panel's own night mode: everything the plugin paints goes to the
                     red night-vision scheme, and nothing outside the panel changes. -->
                <Button Content="{Binding NightLabel}" Padding="8,2" Margin="0,0,8,0"
                    Foreground="{DynamicResource ButtonForegroundBrush}"
                    Command="{Binding ToggleNightModeCommand}"
                    ToolTip="Red night-vision palette for this panel only - the rest of N.I.N.A. keeps its own colours. The app-wide version is the eye button in N.I.N.A.'s title bar."/>
                <TextBlock VerticalAlignment="Center" FontSize="14"
                    Text="{Binding Planner.SelectedDateLabel}"
                    Foreground="{DynamicResource PrimaryBrush}"/>
            </StackPanel>

            <!-- Hour-by-hour scrub. Dragging on the chart, the mouse wheel over it and
                 the left/right arrow keys move the same marker; these buttons are the
                 clickable form of it, and the label is the readout. -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,0,2,4">
                <Button Content="&lt; hr" Padding="8,2" Margin="0,0,4,0"
                    Foreground="{DynamicResource ButtonForegroundBrush}"
                    Command="{Binding ScrubBackCommand}"
                    ToolTip="Scrub one hour earlier (also: left arrow, mouse wheel, dragging on the chart)"/>
                <Button Content="hr &gt;" Padding="8,2" Margin="0,0,4,0"
                    Foreground="{DynamicResource ButtonForegroundBrush}"
                    Command="{Binding ScrubForwardCommand}"
                    ToolTip="Scrub one hour later (also: right arrow, mouse wheel, dragging on the chart)"/>
                <Button Content="off" Padding="8,2" Margin="0,0,8,0"
                    Foreground="{DynamicResource ButtonForegroundBrush}"
                    Command="{Binding ScrubClearCommand}"
                    ToolTip="Remove the scrub marker (also: Escape over the chart)"/>
                <TextBlock VerticalAlignment="Center" FontSize="13"
                    Text="{Binding Planner.ScrubLabel}"
                    Foreground="{DynamicResource SecondaryBrush}"/>
            </StackPanel>

            <!-- Chart frame length. One night is noon to noon, like the desktop
                 planner; a week fits the same pixels. The panel width is not allowed to
                 decide this on its own - a wide panel used to show two nights
                 unasked. Enabled state is bound to the view model rather than left to
                 the commands: in a dockable pane a click on + did not re-query the -
                 button, which left it greyed out and the frame could only ever grow. -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,0,2,4">
                <Button Content="-" Padding="8,2" Margin="0,0,4,0"
                    Foreground="{DynamicResource ButtonForegroundBrush}"
                    IsEnabled="{Binding Planner.CanZoomIn}"
                    Command="{Binding ZoomInCommand}"
                    ToolTip="Fewer nights on the chart (down to one night, noon to noon)"/>
                <Button Content="+" Padding="8,2" Margin="0,0,8,0"
                    Foreground="{DynamicResource ButtonForegroundBrush}"
                    IsEnabled="{Binding Planner.CanZoomOut}"
                    Command="{Binding ZoomOutCommand}"
                    ToolTip="More nights on the chart (up to a week)"/>
                <TextBlock VerticalAlignment="Center" FontSize="13"
                    Text="{Binding Planner.ZoomLabel}"
                    Foreground="{DynamicResource SecondaryBrush}"/>
            </StackPanel>

            <!-- Status line -->
            <TextBlock Grid.Row="3" Margin="2,0,2,4" FontSize="11"
                Text="{Binding Planner.StatusText}"
                Foreground="{DynamicResource SecondaryBrush}"/>

            <!-- Chart stretches to fill the panel; the night strip keeps a
                 fixed, scrolling height so a tall panel never leaves dead
                 space under the list or squeezes the chart away. -->
            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <planner:NightChartControl x:Name="NightChart" Grid.Row="0" Margin="2" MinHeight="160"/>
                <ListBox Grid.Row="1" Margin="2" MaxHeight="240"
                    ItemsSource="{Binding Planner.Nights}"
                    SelectedItem="{Binding Planner.SelectedNight, Mode=TwoWay}"
                    Background="{DynamicResource BackgroundBrush}"
                    planner:PlannerViewGlue.Chart="{Binding ElementName=NightChart}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Summary}" FontSize="12"
                                Foreground="{DynamicResource PrimaryBrush}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
